{
  "name": "museum-perf-demo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Art museum landing page with a deliberate performance bug, for demoing Lighthouse + React DevTools Profiler.",
  "scripts": {
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "prod": "npm run build && npm start"
  },
  "engines": {
    "node": ">=18.18"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "express": "^4.22.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.6",
    "vite": "^5.4.21"
  }
}
